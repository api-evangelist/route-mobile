    {
      "info": {
        "name": "Capability Check API",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Bulk Capability Check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apis.rmlconnect.net/v1/capabilityCheck/getCapabilityDetails",
            "params": [
              {
                "name": "startDate",
                "value": "",
                "type": "query",
                "description": "The start date for filtering capability check results (YYYY-MM-DD)."
              },
              {
                "name": "endDate",
                "value": "",
                "type": "query",
                "description": "The end date for filtering capability check results (YYYY-MM-DD)."
              },
              {
                "name": "pageNo",
                "value": "",
                "type": "query",
                "description": "The page number for paginated results (starts at 1)."
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "The number of records to return per page."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "The Bulk Capability Check API retrieves RCS capability details for phone numbers that were submitted for capability checking. Use the date range and optional status filter to paginate through results."
        },
        {
          "info": {
            "name": "Check Bulk Capability",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://apis.rmlconnect.net/v1/capabilityCheck/checkBulkCapability",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "botName",
                  "type": "text",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Upload a CSV file containing phone numbers to trigger a bulk RCS capability check. The file should contain one phone number per row. After submission, use the Fetch Bulk Capability Details API to retrieve the results once processing is complete."
        }
      ]
    }
