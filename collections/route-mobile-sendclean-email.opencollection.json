    {
      "info": {
        "name": "Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Add a webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sendclean.net/v1.0/settings/addWebhook",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Registers a new webhook URL to receive email event notifications.\n\n**Supported events:** `send`, `open`, `click`, `soft_bounce`, `hard_bounce`, `spam`\n\n**Important:** The webhook URL must respond with `God bless you, SendClean` to pass the validation check.\n\nSendClean signs webhook POST requests with an HMAC-SHA1 signature in the `X-SendCleanTES-SIGNATURE`\nheader for optional verification. See the Webhook Authentication section for details.\n"
        },
        {
          "info": {
            "name": "Edit a webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sendclean.net/v1.0/settings/editWebhook",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the configuration of an existing webhook."
        },
        {
          "info": {
            "name": "Reset webhook authentication key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sendclean.net/v1.0/settings/keyResetWebhook",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generates a new authentication/signing key for the specified webhook.\n\n**Note:** SendClean immediately begins using the new key. To avoid dropping webhook batches,\nreturn a non-200 status for any batches that fail signature verification, and update your\napplication with the new key before retrying.\n"
        },
        {
          "info": {
            "name": "List all webhooks",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sendclean.net/v1.0/settings/listWebhook",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Returns all webhooks registered to the account."
        },
        {
          "info": {
            "name": "Delete a webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sendclean.net/v1.0/settings/deleteWebhook",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Permanently removes a webhook from the account."
        },
        {
          "info": {
            "name": "Get webhook details",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sendclean.net/v1.0/settings/getWebhookInfo",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Returns detailed information about a specific webhook, including delivery stats."
        }
