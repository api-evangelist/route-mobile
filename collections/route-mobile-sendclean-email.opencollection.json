    {
      "info": {
        "name": "Messages",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Send a transactional email",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sendclean.net/v1.0/messages/sendMail",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Sends a new transactional email via the specified SMTP sub-user.\n\nEither `html` or `text` content is required in the message body (both may be provided).\n\nUse the `headers` object to control tracking, signing, and routing behaviour.\nUse `X-Unique-Id` in headers to tag messages for later retrieval via `/messages/getMessageInfo`.\n"
        },
        {
          "info": {
            "name": "Send email using a saved template",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sendclean.net/v1.0/messages/sendTemplate",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Sends a transactional email using a pre-created template.\nUse `dynamic_value` to replace template placeholders (case-sensitive field names).\n"
        },
        {
          "info": {
            "name": "Send template email via HTTP GET",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sendclean.net/v1.0/messages/sendTemplateHTTPGet",
            "params": [
              {
                "name": "owner_id",
                "value": "",
                "type": "query",
                "description": "A valid SendClean User ID"
              },
              {
                "name": "token",
                "value": "",
                "type": "query",
                "description": "A valid API token"
              },
              {
                "name": "smtp_user_name",
                "value": "smtp12345",
                "type": "query",
                "description": "A valid SMTP user name"
              },
              {
                "name": "template_id",
                "value": "",
                "type": "query",
                "description": "Previously created template ID"
              },
              {
                "name": "subject",
                "value": "",
                "type": "query",
                "description": "URL-encoded email subject"
              },
              {
                "name": "from_email",
                "value": "",
                "type": "query",
                "description": "URL-encoded sender email address"
              },
              {
                "name": "to",
                "value": "",
                "type": "query",
                "description": "URL-encoded recipient email address"
              },
              {
                "name": "dynamic_value[NAME]",
                "value": "",
                "type": "query",
                "description": "URL-encoded dynamic value for NAME placeholder"
              },
              {
                "name": "dynamic_value[Email]",
                "value": "",
                "type": "query",
                "description": "URL-encoded dynamic value for Email placeholder"
              }
            ]
          },
          "docs": "Sends a transactional email using a template via HTTP GET. Designed for simple integrations\nsuch as IVR webhooks where POST with JSON body is not practical.\n\n**All parameter values must be URL-encoded.**\n\nExample:\n```\nGET https://api.sendclean.net/v1.0/messages/sendTemplateHTTPGet?owner_id=YOUR_ID&token=YOUR_TOKEN\n    &smtp_user_name=smtp12345&template_id=TMPL_ID&subject=Hello\n    &from_email=info%40example.com&to=customer%40example.com\n    &dynamic_value%5BNAME%5D=John&dynamic_value%5BEmail%5D="
        },
        {
          "info": {
            "name": "Get message delivery and engagement info",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sendclean.net/v1.0/messages/getMessageInfo",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieves delivery status, open data, and click data for messages matching a given `X-Unique-Id`.\nSupports pagination via `skip_page`.\n"
        }
      ]
    },
